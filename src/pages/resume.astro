---
import Base from '../layouts/Base.astro';
import { links } from '../config';
---
<Base title="Resume" description="Resume of Sai Prannav Murali (PDF).">
  <div class="wrap pt-12">
    <p class="mono">Resume</p>
    <h1 class="mt-2 text-3xl sm:text-4xl font-bold">Resume</h1>
    <p class="mt-3 muted max-w-xl">Education, research, papers, internships and projects. This is the current version.</p>
    <p class="mt-6 flex gap-3 flex-wrap">
      <a class="btn btn-primary" href={links.resume}>Open the PDF</a>
      <a class="btn" href={links.resume} download>Download</a>
    </p>
    <object data={`${links.resume}#view=FitH`} type="application/pdf" class="mt-8 w-full border border-[var(--rule)] bg-[var(--surface)] hidden md:block" style="height:80vh" aria-label="Resume PDF">
      <p class="p-6">Your browser can't show the PDF here. <a class="underline" href={links.resume}>Open it directly.</a></p>
    </object>
  </div>
</Base>
