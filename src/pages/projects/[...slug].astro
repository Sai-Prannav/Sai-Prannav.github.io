---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Slot from '../../components/Slot.astro';
import { links } from '../../config';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { p } }));
}
const { p } = Astro.props;
const { Content } = await render(p);
const repoUrl = p.data.repo ? links.repos[p.data.repo] : undefined;
---
<Base title={p.data.title} description={p.data.summary}>
  <article class="wrap pt-14">
    <a href="/projects/" class="text-sm muted hover:text-[var(--fg)]">All projects</a>
    <p class="mono mt-6">{p.data.context} · {p.data.date}</p>
    <h1 class="mt-2 text-3xl sm:text-4xl font-semibold tracking-tight">{p.data.title}</h1>
    <p class="mt-3 text-lg muted max-w-xl">{p.data.summary}</p>
    <p class="mt-4 flex flex-wrap gap-2 items-center">
      {p.data.status && <span class="tag tag-accent">{p.data.status}</span>}
      {p.data.stack.map((s) => <span class="tag">{s}</span>)}
    </p>
    <p class="mt-4">
      {repoUrl && links.repos.published
        ? <a class="btn" href={repoUrl} rel="noopener">View the repo</a>
        : <span class="tag">Repo coming soon</span>}
    </p>
    {p.data.slot && <div class="mt-8"><Slot title={p.data.slot.title} need={p.data.slot.need} /></div>}
    <div class="prose-site mt-6"><Content /></div>
  </article>
</Base>
