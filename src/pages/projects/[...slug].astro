---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import Withheld from '../../components/Withheld.astro';
import Proof from '../../components/Proof.astro';
import RigInteractive from '../../components/RigInteractive.astro';
import BistableSnap from '../../components/BistableSnap.astro';
import TriageSim from '../../components/TriageSim.astro';
import StockSnapViewer from '../../components/StockSnapViewer.astro';
import { links, linkLabels } from '../../config';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { p } }));
}
const { p } = Astro.props;
const { Content } = await render(p);
const d = p.data;
const repoUrl = d.repo ? links.repos[d.repo] : undefined;
const hasLinks = repoUrl && links.repos.published;
const figs = d.figures.map((f) => ({ ...f }));
const slots = d.figureSlots;
const lead = (i: number) => i === 0 && figs.length > 1 && figs.length % 2 === 1;
const widgetMeta = {
  bistable: ['Why the drive snaps', 'The fish robot is driven by a bistable "hair-clip" mechanism: two stable shapes with an energy barrier between them. Drag the strip past the barrier and it snaps.'],
  triage: ['Try the rules', "HeartBridge's real thresholds, ported to the browser. Move the sliders and the tier and its reasons update, the same way they do for a nurse."],
  stocksnap: ['Drag to reveal the detections', 'Left of the handle is the raw shelf photo. Right of it is the YOLO11 output, drawn by the app.'],
} as const;
---
<Base title={d.title} description={d.summary} progress>
  <article class="wrap pt-10">
    <a href="/projects/" class="text-sm underline">All work</a>

    <header class="mt-6 grid gap-8 lg:grid-cols-[1fr_1.1fr] lg:items-start">
      <div>
        <p class="mono">{d.context} · {d.date}</p>
        <h1 class="mt-2 text-3xl sm:text-4xl font-bold leading-tight">{d.title}</h1>
        <p class="mt-3 text-lg max-w-xl">{d.summary}</p>
        <p class="mt-4 flex flex-wrap gap-2 items-center">
          <span class:list={['chip', d.statusWaiting && 'chip-wait']}>{d.status}</span>
          {d.stack.map((s) => <span class="tag">{s}</span>)}
        </p>
        {(d.posters.length > 0 || d.proof.length > 0) && <div class="mt-5"><Proof posters={d.posters} proof={d.proof} /></div>}
        {hasLinks && (
          <p class="mt-5 flex flex-wrap gap-3">
            {repoUrl && links.repos.published && <a class="btn" href={repoUrl} rel="noopener">View the repo</a>}
          </p>
        )}
      </div>
      <div>
        {d.withheld ? <Withheld ratio="4 / 3" title={d.withheldNote?.title} sub={d.withheldNote?.sub} />
          : d.schematic ? (<RigInteractive prefix="cs" caption="Illustration of the signal chain. Not measured data, and not the exact bench." />)
          : d.card ? <Media {...d.card} ratio="4 / 3" eager />
          : <Media kind="image" src={`/media/${d.cardSlot ?? 'missing.png'}`} alt={d.title} ratio="3 / 2" eager />}
        {d.withheld && <p class="figcap">{d.withheldNote?.caption ?? 'Images withheld until publication. No design detail is shown here.'}</p>}
        {!d.schematic && d.card?.caption && <p class="figcap">{d.card.caption}</p>}
      </div>
    </header>

    {(d.did.length > 0 || d.team.length > 0) && (
      <section class="mt-14" aria-labelledby="role-h">
        <h2 id="role-h" class="text-xl font-bold">Role</h2>
        <div class="mt-4 grid gap-6 sm:grid-cols-2">
          <div class="bg-[var(--surface)] border border-[var(--rule)] p-5">
            <h3 class="mono">What I did</h3>
            <ul class="mt-3 grid gap-2 list-disc pl-5">{d.did.map((x) => <li>{x}</li>)}</ul>
          </div>
          {d.team.length > 0 && (
            <div class="bg-[var(--surface)] border border-[var(--rule)] p-5">
              <h3 class="mono">What the team did</h3>
              <ul class="mt-3 grid gap-2 list-disc pl-5">{d.team.map((x) => <li>{x}</li>)}</ul>
            </div>
          )}
        </div>
      </section>
    )}

    {d.specs.length > 0 && (
      <section class="mt-12" aria-labelledby="spec-h">
        <h2 id="spec-h" class="text-xl font-bold">System specs</h2>
        <table class="spec mt-4 max-w-3xl">
          <tbody>{d.specs.map((s) => <tr><th scope="row">{s.k}</th><td>{s.v}</td></tr>)}</tbody>
        </table>
      </section>
    )}

    {d.widgets.map((w) => (
      <section class="widget" aria-labelledby={`w-${w}`}>
        <h2 id={`w-${w}`} class="text-xl font-bold">{widgetMeta[w][0]}</h2>
        <p class="lead">{widgetMeta[w][1]}</p>
        <div class="mt-4 max-w-4xl">
          {w === 'bistable' && <BistableSnap prefix="cs-bi" />}
          {w === 'triage' && <TriageSim />}
          {w === 'stocksnap' && <StockSnapViewer />}
        </div>
      </section>
    ))}

    <div class="prose-site mt-12"><Content /></div>

    {(figs.length > 0 || slots.length > 0) && (
      <section class="mt-14" aria-labelledby="figs-h">
        <h2 id="figs-h" class="text-xl font-bold">Figures</h2>
        <div class:list={['mt-4 grid gap-6', figs.length + slots.length > 1 && 'sm:grid-cols-2']}>
          {figs.map((f, i) => (
            <figure class:list={[lead(i) && 'sm:col-span-2']}>
              <Media {...f} ratio={f.ratio ?? (lead(i) ? '16 / 9' : '4 / 3')} fit={f.fit ?? 'contain'} />
              <figcaption class="figcap"><span class="text-[var(--accent-ink)]">fig. {String(i + 2).padStart(2, '0')}</span> {f.caption ?? f.alt}</figcaption>
            </figure>
          ))}
          {slots.map((s, i) => (
            <figure>
              <Media kind="image" src={`/media/${s}`} alt={s} ratio="4 / 3" />
              <figcaption class="figcap">fig. {String(figs.length + i + 2).padStart(2, '0')}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    {d.credits && (
      <section class="mt-12 max-w-2xl" aria-labelledby="cred-h">
        <h2 id="cred-h" class="text-xl font-bold">Credits</h2>
        <p class="mt-2 muted">{d.credits}</p>
      </section>
    )}
  </article>
</Base>
