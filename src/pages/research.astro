---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { links } from '../config';

const labs = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(labs.map(async (l) => ({ l, Content: (await render(l)).Content })));
---
<Base title="Research" description="Research at four Kennesaw State labs: soft surgical robots, a fish robot, thermal-fluids and counter-UAS sensing.">
  <div class="wrap pt-12">
    <p class="mono">Research</p>
    <h1 class="mt-2 text-3xl sm:text-4xl font-bold">Four labs at Kennesaw State</h1>
    <p class="mt-3 muted max-w-xl">Every paper here is accepted and not yet presented. My author position is on each one.</p>

    <div class="mt-10 grid gap-6">
      {rendered.map(({ l, Content }) => (
        <article id={l.id} class="bg-[var(--surface)] border border-[var(--rule)] p-5 sm:p-6 scroll-mt-20">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 class="text-xl font-bold">{l.data.lab}</h2>
            <span class="mono">{l.data.period}</span>
          </div>
          <p class="text-sm muted mt-1">{l.data.role} · {l.data.pi}</p>
          <div class="prose-site mt-3 text-[0.95rem]"><Content /></div>
          {l.data.caseStudy && <p class="mt-3"><a class="underline text-[var(--accent-ink)]" href={`/projects/${l.data.caseStudy}/`}>Read the case study</a></p>}

          {l.data.papers.length > 0 && (
            <div class="mt-5">
              <h3 class="mono mb-2">Papers</h3>
              <ul class="grid gap-3">
                {l.data.papers.map((p) => (
                  <li class="border-l-2 border-[var(--accent)] pl-3">
                    <p class="font-medium text-sm">{p.title}</p>
                    <p class="text-xs muted mt-1">{p.venue}</p>
                    <p class="mt-2 flex flex-wrap gap-2"><span class="chip">{p.status}</span><span class="tag">{p.position}</span></p>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {l.data.posters.length > 0 && (
            <div class="mt-5">
              <h3 class="mono mb-2">Posters</h3>
              <ul class="grid gap-3">
                {l.data.posters.map((p) => (
                  <li class="border-l-2 border-[var(--rule)] pl-3">
                    <a class="font-medium text-sm underline" href={links.posters[p.link]} rel="noopener">{p.title}</a>
                    <p class="mt-2 flex flex-wrap gap-2"><span class="tag">KSU Symposium · {p.when}</span><span class="tag">{p.position}</span></p>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {l.data.tags.length > 0 && (
            <p class="mt-5 flex flex-wrap gap-2">{l.data.tags.map((t) => <span class="tag">{t}</span>)}</p>
          )}
        </article>
      ))}
    </div>
  </div>
</Base>
