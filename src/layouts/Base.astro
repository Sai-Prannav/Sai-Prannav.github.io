---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { site, links, nav } from '../config';
interface Props { title?: string; description?: string; progress?: boolean; }
const { title, description = site.description, progress = false } = Astro.props;
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const palette = [
  { label: 'Home', hint: 'page', href: '/' },
  { label: 'Work', hint: 'page', href: '/projects/' },
  { label: 'Research', hint: 'page', href: '/research/' },
  { label: 'About', hint: 'page', href: '/about/' },
  { label: 'Resume', hint: 'page', href: '/resume/' },
  ...projects.map((p) => ({ label: p.data.title, hint: p.data.context, href: `/projects/${p.id}/` })),
  { label: 'Copy email address', hint: 'action', copy: links.email },
  { label: 'Open resume (PDF)', hint: 'action', href: links.resume, ext: true },
  { label: 'GitHub', hint: 'link', href: links.github, ext: true },
  { label: 'LinkedIn', hint: 'link', href: links.linkedin, ext: true },
];
const full = title ? `${title} | ${site.name}` : `${site.name} | Robotics`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const og = new URL('/og.png', site.url).href;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;700&display=swap" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={full} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="theme-color" content="#F6F4EF" />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body class="min-h-screen flex flex-col">
    {progress && <div class="progress" data-progress aria-hidden="true"></div>}
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 btn btn-primary">Skip to content</a>
    <header class="border-b border-[var(--rule)] sticky top-0 z-40 bg-[var(--paper)]">
      <div class="wrap flex items-center justify-between h-14 gap-3">
        <a href="/" class="font-display font-bold tracking-tight whitespace-nowrap text-[0.9rem] sm:text-base">{site.name}</a>
        <nav aria-label="Main" class="flex items-center gap-2.5 sm:gap-6 text-[0.8rem] sm:text-sm">
          {nav.filter((n) => n.label !== 'Resume').map((n) => (
            <a href={n.href} class="hover:text-[var(--accent-ink)] py-2" aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
          <a href="/resume/" class="btn !py-1 !px-2.5 !text-[0.8rem] sm:!text-sm" aria-current={path.startsWith('/resume') ? 'page' : undefined}>Resume</a>
          <button type="button" class="kbd-btn" data-open-palette aria-label="Open command menu (Ctrl or Command K)"><kbd>Ctrl K</kbd></button>
        </nav>
      </div>
    </header>
    <main id="main" class="flex-1"><slot /></main>
    <footer class="border-t border-[var(--rule)] mt-24">
      <div class="wrap py-8 grid gap-4 sm:flex sm:items-center sm:justify-between text-sm">
        <div>
          <p class="font-display font-bold">{site.name}</p>
          <p class="muted">{site.location}</p>
        </div>
        <p class="flex flex-wrap gap-x-5 gap-y-1">
          <a href={`mailto:${links.email}`} class="underline">{links.email}</a>
          <a href={links.github} rel="me" class="underline">GitHub</a>
          <a href={links.linkedin} rel="me" class="underline">LinkedIn</a>
          <a href={`mailto:${links.emailSchool}`} class="muted underline">KSU email</a>
          <button type="button" class="underline muted jump" data-open-palette>Jump to…</button>
        </p>
      </div>
    </footer>
    <script type="application/json" id="pal-data" set:html={JSON.stringify(palette)} />
    <script>
      import '../scripts/enhance';
      import '../scripts/palette';
    </script>
    <script>
      // Muted looping clips: play only when on screen, and never for people who ask for less motion.
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const vids = document.querySelectorAll<HTMLVideoElement>('video[data-loop]');
      if (!reduce && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            const v = e.target as HTMLVideoElement;
            if (e.isIntersecting) { v.preload = 'auto'; v.play().catch(() => {}); } else { v.pause(); }
          });
        }, { threshold: 0.25 });
        vids.forEach((v) => io.observe(v));
      }
    </script>
  </body>
</html>
