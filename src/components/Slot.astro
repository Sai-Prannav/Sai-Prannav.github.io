---
// Designed empty-state frame for a photo, GIF or screenshot that doesn't exist yet.
// Each one is listed in VISUALS_NEEDED.md.
interface Props { title: string; need: string; ratio?: string; }
const { title, need, ratio = '16 / 9' } = Astro.props;
---
<figure class="slot" style={`aspect-ratio:${ratio}`} role="img" aria-label={`Placeholder: ${title}`}>
  <div>
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="mx-auto mb-2 opacity-70"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="11" r="2"/><path d="m21 16-5-5-8 8"/></svg>
    <p class="mono">{title}</p>
    <p class="text-xs mt-1 max-w-xs mx-auto">{need}</p>
  </div>
</figure>
