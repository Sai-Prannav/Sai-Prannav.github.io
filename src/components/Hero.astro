---
import { site, links } from '../config';
---
<section class="relative overflow-hidden border-b border-[var(--line)]">
  <canvas id="cloud" class="absolute inset-0 w-full h-full" aria-hidden="true"></canvas>
  <div class="wrap relative py-24 sm:py-32 lg:py-40 pointer-events-none">
    <p class="mono reveal">Mechanical engineering · Kennesaw State</p>
    <h1 class="mt-3 text-4xl sm:text-6xl font-semibold tracking-tight reveal" style="animation-delay:.05s">{site.name}</h1>
    <p class="mt-5 max-w-xl text-lg sm:text-xl muted reveal" style="animation-delay:.1s">{site.tagline}</p>
    <div class="mt-8 flex flex-wrap gap-3 pointer-events-auto reveal" style="animation-delay:.15s">
      <a class="btn btn-primary" href={links.resume}>Resume (PDF)</a>
      <a class="btn" href={links.github}>GitHub</a>
      <a class="btn" href={links.linkedin}>LinkedIn</a>
      <a class="btn" href={`mailto:${links.email}`}>Email</a>
    </div>
  </div>
</section>
<script>
  const c = document.getElementById('cloud') as HTMLCanvasElement | null;
  if (c) {
    // Lazy: load the animation after first paint.
    const go = () => import('../scripts/pointcloud').then((m) => m.startPointCloud(c));
    'requestIdleCallback' in window ? (window as any).requestIdleCallback(go) : setTimeout(go, 200);
  }
</script>
