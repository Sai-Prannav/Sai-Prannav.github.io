---
interface Props { ratio?: string; }
const { ratio = '4 / 3' } = Astro.props;
---
<div class="fig" style={`aspect-ratio:${ratio}`}>
  <div class="withheld" role="img" aria-label="Images withheld until publication">
    <div>
      <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="mx-auto mb-2"><rect x="5" y="11" width="14" height="9" rx="1.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
      <p class="mono">Images withheld</p>
      <p class="mono-n mt-1">until publication</p>
    </div>
  </div>
</div>
